# --- Server configurations ---
PORT=port_number_here (e.g., 8080)

# --- Provider (github or gitlab) ---
GIT_PROVIDER=provider_name_here

# --- GitHub Configurations ---
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username_or_organization_here
GITHUB_REPO=your_repository_name_here

# --- GitLab Configurations ---
GITLAB_URL=base_url_of_your_gitlab_instance_here
GITLAB_TOKEN=your_gitlab_personal_access_token_here
GITLAB_PROJECT_ID=your_gitlab_project_id_here

# --- Path to the JSON configuration directory in the repository ---
CONFIG_FILE_PATH=path_to_your_json_configuration_directory_in_the_repository_here (e.g., configs/)
SCHEMA_FILE_PATH=path_to_your_json_schema_directory_in_the_repository_here (e.g., schemas/) 